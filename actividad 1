# ejemplo de arreglo:
public class ArregloBidimensional {
    public static void main(String[] args) {
        // 1. Declaración e inicialización directa de una matriz de 3x3
        int[][] matriz = {
            {1, 2, 3},
            {4, 5, 6},
            {7, 8, 9}
        };

        // 2. Mostrar los elementos de la matriz usando ciclos for anidados
        System.out.println("Mostrando la matriz elementos por elemento:");
        for (int i = 0; i < matriz.length; i++) { // Recorre las filas
            for (int j = 0; j < matriz[i].length; j++) { // Recorre las columnas
                System.out.print(matriz[i][j] + " ");
            }
            System.out.println(); // Salto de línea por cada fila
        }
    }
}